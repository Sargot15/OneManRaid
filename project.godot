; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OneManRaid"
run/main_scene="res://game/scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://game/globals/globals.gd"
FloatingTextManager="*res://game/globals/floating_text_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://assets/": "blue",
"res://game/enemies/": "red",
"res://game/player/": "green",
"res://game/prefabs/": "orange"
}

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Walls"
2d_physics/layer_3="Boss"
2d_physics/layer_4="EnemyBullets"
2d_physics/layer_5="AreaDamage"
